# Marking Assistant configuration.
# Copy to `.env` (never commit .env) and adjust. Every variable is optional; defaults shown.

# Runtime mode: development | production | test.
# development serves the OpenAPI schema at /api/openapi.json.
MARGIN_ENV=development

# Address the web app listens on. Use 0.0.0.0 to serve other computers on the school network.
MARGIN_HOST=127.0.0.1
MARGIN_PORT=8000

# DEBUG | INFO | WARNING | ERROR
MARGIN_LOG_LEVEL=INFO

# Where the database, uploaded scans, page images and logs are stored.
# Must not be inside any publicly served folder. Back this folder up.
# Default: <repo>/data
# MARGIN_DATA_DIR=/var/lib/marking-assistant

# Built frontend served by the backend. Default: <repo>/frontend/dist
# MARGIN_FRONTEND_DIST=/opt/marking-assistant/frontend/dist

# Database. Unset: SQLite file at <MARGIN_DATA_DIR>/margin.db (recommended for one school).
# MARGIN_DATABASE_URL=sqlite:////var/lib/marking-assistant/margin.db

# Sign-in sessions end after this many idle minutes, and always after this many hours.
MARGIN_SESSION_IDLE_MINUTES=120
MARGIN_SESSION_ABSOLUTE_HOURS=12

# Sign-in throttling: after this many failures for one username within the window,
# further attempts are refused until the window has passed.
MARGIN_LOGIN_MAX_FAILURES=5
MARGIN_LOGIN_FAILURE_WINDOW_MINUTES=15

# Scanned uploads. Larger files are refused. Rendering runs in a separate process that is
# stopped after the timeout (seconds); PDFs with more pages are refused.
MARGIN_MAX_UPLOAD_MB=500
MARGIN_MAX_PDF_PAGES=1000
MARGIN_RENDER_TIMEOUT_SECONDS=900

# Page images: resolution (dpi) and JPEG quality. About 137 MB per 50-student class at the
# defaults (measured on simulated scans; see docs/DECISIONS.md D-031).
MARGIN_PAGE_DPI=200
MARGIN_PAGE_JPEG_QUALITY=90

# Local model server (Ollama). This is the ONLY network host the application may contact.
# It must be on this computer or the school's private network, or the app refuses to start.
MARGIN_MODEL_BASE_URL=http://127.0.0.1:11434
# Set to true only if you deliberately use a model server outside the school network.
MARGIN_ALLOW_PUBLIC_MODEL_HOST=false

# AI models. "mock" needs no model server (demos, development); "ollama" uses the models below.
MARGIN_AI_BACKEND=mock
MARGIN_READER_MODEL=qwen3-vl:8b
MARGIN_MARKER_MODEL=qwen3-vl:8b
# Seconds to wait for one model reply (slow machines need a lot).
MARGIN_MODEL_TIMEOUT_SECONDS=900
# Extra attempts when a model reply fails validation, before flagging for manual marking.
MARGIN_MODEL_OUTPUT_RETRIES=2
# Page images are shrunk to at most this many pixels on the long side before sending.
MARGIN_READER_MAX_IMAGE_PX=1600
# Mock models only: artificial delay per call (seconds).
MARGIN_MOCK_DELAY_SECONDS=0

# Background worker. Failed jobs are retried with backoff this many times.
MARGIN_JOB_MAX_ATTEMPTS=6
MARGIN_WORKER_POLL_SECONDS=2
# A running job with no heartbeat for this many seconds is treated as abandoned and re-run.
MARGIN_JOB_STALE_SECONDS=120

# Session cookies are marked Secure (HTTPS only). Unset: true in production, false otherwise.
# MARGIN_COOKIE_SECURE=true

# Production refuses to start when MARGIN_COOKIE_SECURE=false unless this is true.
# Only for a deliberate, temporary plain-HTTP setup on a trusted school network.
MARGIN_ALLOW_INSECURE_COOKIES_IN_PRODUCTION=false

# Development only: where the Vite dev server proxies /api requests.
# MARGIN_BACKEND_URL=http://127.0.0.1:8000
